// Configuración de TypeScript para herramientas que se ejecutan con Node.js.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "playwright.config.*",
    "eslint.config.*"
  ],
  "compilerOptions": {
    // La mayoría de las herramientas transforman el código antes de ejecutarlo.
    // Este modo facilita el trabajo con herramientas que agrupan archivos.
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,

    // Incluye los tipos de Node.js sin añadir otros tipos por accidente.
    "types": ["node"],

    // Evita generar archivos al comprobar los tipos.
    "noEmit": true,

    // vue-tsc crea un archivo de información para comprobar cambios más rápido.
    // Guardamos ese archivo fuera de la carpeta principal.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
