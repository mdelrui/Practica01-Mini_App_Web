{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    // Activa comprobaciones adicionales al consultar listas y objetos.
    "noUncheckedIndexedAccess": true,

    // Permite usar rutas más sencillas al importar archivos.
    "paths": {
      "@/*": ["./src/*"]
    },

    // vue-tsc crea un archivo de información para comprobar cambios más rápido.
    // Guardamos ese archivo fuera de la carpeta principal.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
