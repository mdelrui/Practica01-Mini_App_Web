{
  "extends": "./tsconfig.app.json",

  // Incluye los archivos de pruebas y elimina exclusiones anteriores.
  // El código de la aplicación usado por las pruebas se incluye automáticamente.
  "include": ["src/**/__tests__/*", "env.d.ts"],
  "exclude": [],

  "compilerOptions": {
    // Vitest ejecuta las pruebas en un entorno diferente al de la aplicación.
    // Ajusta las bibliotecas y los tipos para ese entorno.
    "lib": [],
    "types": ["node", "jsdom"],

    // vue-tsc crea un archivo de información para comprobar cambios más rápido.
    // Guardamos ese archivo fuera de la carpeta principal.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
