OPENROUTER_API_KEY=tu_clave_aqui
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_TIMEOUT=30
# Values must come from the same configured Clerk instance as the frontend.
CLERK_ISSUER=url_de_clerk_issuer
CLERK_JWKS_URL=url_de_clerk_jwks
# Example finite JWKS request timeout in seconds; confirm the deployment value.
CLERK_JWKS_TIMEOUT=5
# Qué dominios puede hacer request a la API
CORS_ORIGINS=http://localhost:5173
